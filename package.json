{
  "name": "@armikom/api-client",
  "version": "1.0.0",
  "description": "TypeScript client for the Armikom API — generated transport plus the hand-written core runtime (contract api-v1.2)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./core": {
      "types": "./dist/esm/src/core/index.d.ts",
      "import": "./dist/esm/src/core/index.js",
      "require": "./dist/cjs/src/core/index.js"
    },
    "./generated": {
      "types": "./dist/esm/generated/index.d.ts",
      "import": "./dist/esm/generated/index.js",
      "require": "./dist/cjs/generated/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "generate": "make generate",
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalise-dist.mjs",
    "test": "make test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "yaml": "2.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
